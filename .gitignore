# ============================================================
# Virtual Memory Simulator & Page Replacement Analysis Platform
# Top-level .gitignore (covers frontend/ and backend/)
# ============================================================

# ---------------------------------------------------------------
# Node / npm / Vite (frontend)
# ---------------------------------------------------------------
node_modules/
dist/
dist-ssr/
.vite/
*.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------
# Python (backend)
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# Packaging / build artifacts (not used by this project, ignored defensively)
build/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Testing / coverage
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.cover
htmlcov/
.hypothesis/
.tox/

# Type checkers / linters (caches)
.mypy_cache/
.ruff_cache/
.pyre/

# ---------------------------------------------------------------
# Environment variables / secrets
# ---------------------------------------------------------------
.env
.env.local
.env.*.local
.env.development
.env.production
.env.test

# ---------------------------------------------------------------
# IDE / editor files
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ---------------------------------------------------------------
# OS-generated files
# ---------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# ---------------------------------------------------------------
# Logs
# ---------------------------------------------------------------
*.log
logs/
